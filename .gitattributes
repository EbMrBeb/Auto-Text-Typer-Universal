# Normalise everything to LF by default; Git still stores LF internally and
# only converts on checkout for whoever has core.autocrlf turned on.
* text=auto eol=lf

# Windows-only packaging scripts round-trip more cleanly through Windows
# tooling (PowerShell ISE/Notepad, Inno Setup's own editor) with real CRLF.
*.ps1 text eol=crlf
*.iss text eol=crlf

# Generated icons: binary, never line-ending-normalised or diffed as text.
*.png binary
*.ico binary
*.icns binary
